{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-coworker-staging",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "services": [
    { "binding": "ATLAS_RESEARCH_PROXY", "service": "atlas-research-proxy" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "main": ".open-next/worker.js"
}
