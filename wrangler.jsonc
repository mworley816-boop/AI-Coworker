{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-coworker-staging",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "main": ".open-next/worker.js"
}
